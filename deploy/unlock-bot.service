[Unit]
Description=Pre-unlock short alerts (MEXC futures, traded by hand)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyper
WorkingDirectory=/opt/hyperdata
EnvironmentFile=-/etc/hyperdata/telegram.env
# Alerts only -- no exchange keys. MEXC's contract API cannot place orders (under
# maintenance since 2022), so the trades are placed by hand and reported back by button.
# --notional is per leg, used for the sizes in the alert text.
ExecStart=/usr/bin/python3 /opt/hyperdata/unlock_bot.py \
    --datadir /opt/hyperdata/unlocks \
    --notional 100 \
    --min-size 0.05
Restart=always
RestartSec=30
StandardOutput=append:/opt/hyperdata/unlocks/service.out
StandardError=append:/opt/hyperdata/unlocks/service.err

[Install]
WantedBy=multi-user.target
