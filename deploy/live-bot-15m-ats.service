[Unit]
Description=Hyperliquid fade LIVE bot (15m, avg-trade-size sizing) — REAL MONEY
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyper
WorkingDirectory=/opt/hyperdata
EnvironmentFile=-/etc/hyperdata/telegram.env
# HL_ACCOUNT_ADDRESS + HL_SECRET_KEY (API wallet). Must be root-owned, chmod 600.
EnvironmentFile=/etc/hyperdata/live.env
# NOTE: --live is what arms real orders. Drop it for a dry run.
# Caps are deliberately small; raise them only after the live fill rate is measured.
# Deliberately tight for the testing phase, against $710 of spot collateral at 3x.
# 5 slots does bind -- pinned there 47% of the time, and 5 slots only sustains ~31
# trades/day at the measured 3.8h average hold against ~41 signals/day, so signals
# ARE being turned away. That is accepted on purpose: signals arrive in correlated
# bursts (three same-direction longs fired 38s apart on one bar), and a low slot
# count is a blunt but effective cap on how much one market move can load up.
# Raise only alongside a per-side cap, and once the arm's live edge is established.
ExecStart=/opt/hyperdata/venv/bin/python /opt/hyperdata/live_bot_ats.py \
    --datadir /opt/hyperdata/live_15m_ats \
    --live \
    --notional 25 \
    --max-gross 250 \
    --max-positions 5 \
    --daily-loss-limit 15
Restart=always
RestartSec=15
StandardOutput=append:/opt/hyperdata/live_15m_ats/service.out
StandardError=append:/opt/hyperdata/live_15m_ats/service.err

[Install]
WantedBy=multi-user.target
