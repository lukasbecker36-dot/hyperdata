[Unit]
Description=Weekend gap logger (HL xyz vs Aster price gap on the same stock/commodity perps, no orders) via @Hyperfadebot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyper
WorkingDirectory=/opt/hyperdata
EnvironmentFile=-/etc/hyperdata/telegram.env
# Public market data only: never reads live.env, holds no key, cannot place an order.
ExecStart=/usr/bin/python3 /opt/hyperdata/weekend_gap.py --datadir /opt/hyperdata/gap
Restart=always
RestartSec=30
StandardOutput=append:/opt/hyperdata/gap/service.out
StandardError=append:/opt/hyperdata/gap/service.err

[Install]
WantedBy=multi-user.target
