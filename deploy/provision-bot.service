[Unit]
Description=MEXC new-listing dip-provision paper bot (all Day 3-45 crypto listings)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyper
WorkingDirectory=/opt/hyperdata
EnvironmentFile=-/etc/hyperdata/telegram.env
ExecStart=/usr/bin/python3 /opt/hyperdata/provision_bot.py --datadir /opt/hyperdata/paper_provision --label provision
Restart=always
RestartSec=15
StandardOutput=append:/opt/hyperdata/paper_provision/service.out
StandardError=append:/opt/hyperdata/paper_provision/service.err

[Install]
WantedBy=multi-user.target
