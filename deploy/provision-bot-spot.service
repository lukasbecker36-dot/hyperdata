[Unit]
Description=MEXC dip-provision paper bot (SPOT books - the venue that can actually be traded)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyper
WorkingDirectory=/opt/hyperdata
EnvironmentFile=-/etc/hyperdata/telegram.env
ExecStart=/usr/bin/python3 /opt/hyperdata/provision_bot.py --venue spot --datadir /opt/hyperdata/paper_provision_spot --label provision-spot
Restart=always
RestartSec=15
StandardOutput=append:/opt/hyperdata/paper_provision_spot/service.out
StandardError=append:/opt/hyperdata/paper_provision_spot/service.err

[Install]
WantedBy=multi-user.target
